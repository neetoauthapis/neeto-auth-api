{
  "$schema": "https://mintlify.com/docs.json",
  "name": "NeetoAuth Docs",
  "description": "API reference, CLI, and MCP server for NeetoAuth.",
  "theme": "mint",
  "colors": {
    "primary": "#10B981",
    "light": "#34D399",
    "dark": "#059669"
  },
  "logo": "/assets/logo.svg",
  "favicon": "/assets/favicon.ico",
  "navbar": {
    "links": [
      {
        "label": "Help Center",
        "href": "https://help.neetoauth.com"
      }
    ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/neetohq",
      "linkedin": "https://www.linkedin.com/company/neeto",
      "youtube": "https://www.youtube.com/channel/UCoQ3Kv2JdZ51WZJ3QFFcI9g",
      "slack": "https://www.launchpass.com/neetohq"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "API",
        "icon": "code",
        "groups": [
          {
            "group": "Getting Started",
            "icon": "rocket",
            "pages": [
              "api/introduction",
              "api/workspace-subdomain",
              "api/authentication",
              "api/pagination",
              "api/response-codes"
            ]
          },
          {
            "group": "Users",
            "icon": "user-group",
            "pages": [
              "api/users/list",
              "api/users/add",
              "api/users/remove"
            ]
          },
          {
            "group": "Products",
            "icon": "grid-2",
            "pages": [
              "api/products/list"
            ]
          }
        ]
      },
      {
        "tab": "CLI",
        "icon": "rectangle-terminal",
        "groups": [
          {
            "group": "Getting Started",
            "icon": "rocket",
            "pages": [
              "cli/introduction",
              "cli/installation",
              "cli/authentication",
              "cli/output-formats",
              "cli/ai-assistants",
              "cli/troubleshooting"
            ]
          },
          {
            "group": "Commands",
            "icon": "terminal",
            "pages": [
              "cli-reference/overview",
              "cli-reference/users",
              "cli-reference/products",
              "cli-reference/utility"
            ]
          }
        ]
      },
      {
        "tab": "MCP",
        "icon": "plug",
        "groups": [
          {
            "group": "Getting Started",
            "icon": "rocket",
            "pages": [
              "mcp/introduction",
              "mcp/authentication",
              "mcp/connect",
              "mcp/examples",
              "mcp/troubleshooting"
            ]
          },
          {
            "group": "Reference",
            "icon": "wrench",
            "pages": [
              "mcp/tools"
            ]
          }
        ]
      }
    ]
  },
  "redirects": [
    {
      "source": "/getting-started/introduction",
      "destination": "/api/introduction"
    },
    {
      "source": "/getting-started/workspace-subdomain",
      "destination": "/api/workspace-subdomain"
    },
    {
      "source": "/getting-started/authentication",
      "destination": "/api/authentication"
    },
    {
      "source": "/getting-started/pagination",
      "destination": "/api/pagination"
    },
    {
      "source": "/getting-started/response-codes",
      "destination": "/api/response-codes"
    },
    {
      "source": "/getting-started",
      "destination": "/api/introduction"
    },
    {
      "source": "/api-reference/:slug*",
      "destination": "/api/:slug*"
    }
  ],
  "api": {
    "params": {
      "expanded": "all"
    },
    "playground": {
      "display": "interactive",
      "proxy": true
    },
    "examples": {
      "languages": [
        "curl",
        "javascript",
        "python"
      ],
      "defaults": "all"
    }
  },
  "styling": {
    "eyebrows": "section",
    "codeblocks": "system"
  },
  "appearance": {
    "default": "light",
    "strict": true
  }
}
